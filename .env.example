# ==========================================
# JazzyVault Backend — Environment Variables
# ==========================================
# Copy this file to .env for local development.
# In Render: Dashboard → your service → Environment → add each key below.

# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase ---
# Found in Supabase Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Service role key — NEVER expose this to the frontend. Backend-only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Found in Supabase Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Storage ---
SUPABASE_STORAGE_BUCKET=jazzyvault-files
MAX_UPLOAD_SIZE_MB=25

# --- AI Provider ---
# Switch providers by changing this one value: gemini | openai | groq
AI_PROVIDER=gemini

# Google Gemini (primary — free tier, used for MVP)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (future/secondary provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (future/secondary provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
